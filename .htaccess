# Ana sitenin güvenlik politikası (CSP) yalnızca aynı sunucudaki videolara izin veriyor
# (media-src 'self'). QR menü videoları bağlantıyla yüklendiği için bu klasöre özel,
# dış video bağlantılarına (https) izin veren bir politika tanımlanır.
<IfModule mod_headers.c>
  Header unset Content-Security-Policy
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' https: blob:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
